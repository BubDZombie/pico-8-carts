pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--paddle
paddle_x=52
paddle_y=122
paddle_width=24
paddle_height=4

--ball
ball_x=64
ball_y=64
ball_size=3
ball_speed_x=5
ball_speed_y=-3

function move_paddle()
  if btn(0) then
    paddle_x-=3
  elseif btn(1) then
    paddle_x+=3
  end
end

function check_reset()
  if btn(4)
    and ball_speed_x == 0
    and ball_speed_y == 0
    then
    ball_speed_x = 5
    ball_speed_y = -3
  end
end

function move_ball()
  ball_x+=ball_speed_x
  ball_y+=ball_speed_y
end

function bounce_ball()
  if ball_x < ball_size
    or ball_x > 128 - ball_size
    then
    ball_speed_x = -ball_speed_x
    sfx(0)
  end
  if ball_y < ball_size then
    ball_speed_y = -ball_speed_y
    sfx(0)
  end
  if ball_y > paddle_y - ball_size then
    if ball_speed_y > 0
      and ball_x > paddle_x
      and ball_x < paddle_x + paddle_width
      then
        ball_speed_y = -ball_speed_y
        sfx(1)
    elseif ball_x < paddle_x
      or ball_x > paddle_x + paddle_width
      then
        ball_speed_x = 0
        ball_speed_y = 0
        ball_x = 64
        ball_y = 64
        sfx(2)
    end
  end
end
    
function _update()
  move_paddle()
  move_ball()
  bounce_ball()
  check_reset()
end

function _draw()
  --clear the screen
  rectfill(0,0,128,128,3)
  
  --draw the paddle
  rectfill(
    paddle_x,
    paddle_y,
    paddle_x+paddle_width,
    paddle_y+paddle_height,
    15
  )
  
  --draw the ball
  circfill(
    ball_x,
    ball_y,
    ball_size,
    15
  )
end
