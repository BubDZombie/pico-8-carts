pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--fly away
--matt maul
cartdata("fly-away")
accel_x=1
accel_y=0.13
ball={
  size=4,
  color=11
}
close_platforms={}
clouds={6,8,10,12}
dead_platforms={}
high_score=dget(0)
platforms={}
platform_color=7
platform_w=16
platform_h=6
string={}
string_length=8
bg_color=12
text_color=1

function check_platforms()
  local close_distance=ball.size + platform_w + platform_h
  close_platforms={}
  dead_platforms={}
  for p in all(platforms) do
    if abs(p.x - ball.x) < close_distance
        or abs(p.y - ball.y) < close_distance
        then
      add(close_platforms,p)
    end
    if p.y > 128 then
      add(dead_platforms,p)
    end
  end
end

function check_space()
  local ceilings={platform_h}
  local right_walls={128}
  local floors={128}
  local left_walls={1}
  local ball_top=ball.y-ball.size-1
  local ball_right=ball.x+ball.size+1
  local ball_bottom=ball.y+ball.size+1
  local ball_left=ball.x-ball.size-1
  for p in all(close_platforms) do
    local platform_top=p.y
    local platform_right=p.x+platform_w
    local platform_bottom=p.y+platform_h
    local platform_left=p.x
    if not(ball_left >= platform_right
        or ball_right <= platform_left) then
      if platform_bottom <= ball_top then
        add(ceilings,platform_bottom)
      elseif platform_top >= ball_bottom then
        add(floors,platform_top)
      end
    end
    if not(ball_top >= platform_bottom
        or ball_bottom <= platform_top) then
      if platform_left >= ball_right then
        add(right_walls,platform_left)
      elseif platform_right <= ball_left then
        add(left_walls,platform_right)
      end
    end
  end
  ball.up_space=128
  for c in all(ceilings) do
    local space=ball_top-c
    if space < ball.up_space then
      ball.up_space=space
    end
  end
  ball.right_space=128
  for w in all(right_walls) do
    local space=w-ball_right
    if space < ball.right_space then
      ball.right_space=space
    end
  end
  ball.down_space=128
  for f in all(floors) do
    local space=f-ball_bottom
    if space < ball.down_space then
      ball.down_space=space
    end
  end
  ball.left_space=128
  for w in all(left_walls) do
    local space=ball_left-w
    if space < ball.left_space then
      ball.left_space = space
    end
  end
  local platform_string=""
  for p in all(close_platforms) do
    platform_string..=p.x..","..p.y.." "
  end
end

function move_ball()
  if btn(⬅️) then
    if ball.speed_x > ball.max_speed * -1 then
      ball.speed_x-=accel_x
    end
  elseif btn(➡️) then
    if ball.speed_x < ball.max_speed then
      ball.speed_x+=accel_x
    end
  elseif ball.speed_x > 0 then
    ball.speed_x-=accel_x
  elseif ball.speed_x < 0 then
    ball.speed_x+=accel_x
  end
  if ball.speed_x < 0 then
    if ball.left_space > ball.speed_x * -1 then
      ball.x+=ball.speed_x
    else
      ball.x-=ball.left_space
      ball.speed_x=0
    end
  elseif ball.speed_x > 0 then
    if ball.right_space > ball.speed_x then
      ball.x+=ball.speed_x
    else
      ball.x+=ball.right_space
      ball.speed_x=0
    end
  end
  if ball.up_space >= ball.speed_y then
    ball.y -= ball.speed_y
  else
    ball.y -= ball.up_space
    ball.speed_y = ball.up_space
  end
  if ball.speed_y < ball.max_speed then
    ball.speed_y+=accel_y
  end
end

function move_string()
  last_x=ball.x
  last_y=ball.y + 3
  for s in all(string) do
    if s.x > last_x + 1 then
      s.x=last_x + 1
    elseif s.x < last_x - 1 then
      s.x=last_x - 1
    else
      s.x=last_x
    end
    
    s.y = last_y + 1
    last_x=s.x
    last_y=s.y
  end
end

function drop()
  drop_speed=flr(camera_speed+camera_speed_delta)
  if ball.up_space < drop_speed
      and ball.y > ball.size then
    ball.y+=drop_speed - ball.up_space
  end
  for p in all(platforms) do
    p.y+=drop_speed
  end
  if ball.y > 128 - ball.size then
    ball.alive=false
    if score > high_score then
      high_score=score
      dset(0,high_score)
    end
  end
end

function add_platforms()
  should_add=true
  for p in all(platforms) do
    if p.y < spread then
      should_add=false
      break
    end
  end
  if should_add then
    local newbies={}
    full=128/platform_w
    for x = 1, 128, platform_w do
      if rnd(platform_chance) > spread then
      --if rnd(256) > spread then
        new={
          x=x,
          y=1,
          cloud=rnd(clouds)
        }
        add(platforms,new)
        add(newbies,new)
      end
    end
    if count(newbies) == full then
      remove = rnd(newbies)
      del(platforms,remove)
    end
    if spread > ball.size * 2 + platform_h * 2
        and rnd() < spread_shrink_chance 
        then
      spread-=1
    end
  end
end

function remove_platforms()
  for p in all(dead_platforms) do
    del(platforms,p)
    score+=1
  end
end

function check_reset()
  if btn(🅾️) then
    reset_game()
  end
end

function reset_game()
  ball.x=64
  ball.y=128-8-string_length
  ball.alive=true
  ball.can_fall=true
  ball.speed_x=0
  ball.speed_y=0
  ball.max_speed=5
  camera_speed=2
  camera_speed_delta=0
  score=0
  spread=40
  spread_shrink_chance=0.10
  platform_chance=2*spread
  for p in all(platforms) do
    del(platforms, p)
  end
  local string_x=ball.x+4
  local string_y=ball.y+8
  string={}
  for i=0, string_length-1 do
    add(
      string,
      {
        x=string_x,
        y=string_y+i
      }
    )
  end
end

function draw_game()
  spr(
    4,
    ball.x-ball.size,
    ball.y-ball.size,
    1,1,
    false,
    false
  )
  for s in all(string) do
    pset(s.x,s.y,7)
  end
  for p in all(platforms) do
--    rectfill(
--      p.x,
--      p.y,
--      p.x+platform_w,
--      p.y+platform_h,
--      platform_color
--    )
    spr(p.cloud,p.x,p.y,2,1)
  end
  print("score "..score,1,122,text_color)
  print("high score "..high_score,64,122,text_color)
end

function print_center(str, y, col)
    local x = 64 - (#tostr(str) * 2) 
    print(str, x, y, col)
end

function draw_score()
  print_center("score: "..score,54,text_color)
  print_center("high score: "..high_score,64,text_color)
  print_center("🅾️ to restart",74,text_color)
end

function _init()
  reset_game()
end

function _update()
  if ball.alive then
    check_platforms()
    check_space()
    move_ball()
    check_space()
    drop()
    move_string()
    add_platforms()
    remove_platforms()
  else
    check_reset()
  end
end

function _draw()
  rectfill(0,0,128,128,bg_color)
  if ball.alive then
    draw_game()
  else
    draw_score()
  end
end


